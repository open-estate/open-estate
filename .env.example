# Open Estate (Personal Research & Non-Commercial Edition) — Environment Configuration
# LICENSE NOTICE: Free for self-hosted personal property research ONLY. Commercial use,
# hosted SaaS/API offerings, brokerage/lending operations, and report resale are strictly
# prohibited (see `LICENSE`). Managed cloud & commercial plans are reserved by OmniSolo LLC.
#
# Copy to `.env` (gitignored) for `docker compose up -d` or local `cargo run --release`.
# All ~50 public federal, state, municipal, and open-data layers work out-of-the-box with ZERO API keys.

# -----------------------------------------------------------------------------
# Server & Storage
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
REPORTS_DIR=reports
DATA_DIR=.cache/datasets
HTTP_CACHE_DIR=.cache/http

# Configurable Brand Identity (defaults to Open Estate / open-estate.local)
BRAND_NAME=Open Estate
BRAND_DOMAIN=open-estate.local
BRAND_TAGLINE="Self-Hosted US Residential & CRE Property Research"
# PUBLIC_BASE_URL=http://localhost:8080

# Public Data Mode (`strict` default — relies 100% on US Federal Public Domain FHFA HPI,
# Census ACS, HUD SAFMR/FMR, BLS CPI, Freddie Mac PMMS & optional BYOK API connectors;
# set `PUBLIC_DATA_MODE=local_csv` only if you manually place local CSVs in `DATA_DIR`)
PUBLIC_DATA_MODE=strict
# HUD_API_TOKEN=
# HUD_FMR_BASE_URL=https://www.huduser.gov/hudapi/public/fmr
# FHFA_TRACT_HPI_URL=

# -----------------------------------------------------------------------------
# Database Backend (`sqlite` WAL by default; `mysql` for MySQL 8.4/9.0)
# -----------------------------------------------------------------------------
DATABASE_PROVIDER=sqlite
SQLITE_DB_PATH=.cache/open-estate.sqlite
# MYSQL_URL=mysql://openestate:openestate@mysql:3306/openestate
# DB_MAX_CONNECTIONS=20

# -----------------------------------------------------------------------------
# OpenAI Responses API (Optional BYOK — enables AI Analyst, Q&A, PDF/HOA/Title Review & NL Search)
# When unset, Open Estate runs 100% deterministically with zero LLM calls.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1
LLM_EFFORT=none
LLM_MATCH_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=gpt-4o-mini
# LLM_QA_EFFORT=medium
# LLM_SLIDES_MODEL=gpt-4o-mini
# LLM_ARTIFACT_MODEL=gpt-4o-mini
# LLM_AGENT_MODEL=gpt-4.1

# -----------------------------------------------------------------------------
# Self-Hosted OSRM Road Routing (Optional — see `deploy/osrm/README.md`)
# Unset = labelled deterministic road-distance estimates (`router.project-osrm.org` is never called).
# Start with `OSRM_BASE_URL=http://osrm:5000 docker compose --profile osrm up -d`
# -----------------------------------------------------------------------------
# OSRM_BASE_URL=http://osrm:5000
# OSRM_REGIONS_JSON=[{"name":"california","bbox":[-124.5,32.5,-114.1,42.0],"baseUrl":"http://osrm:5000"}]
# OSRM_TRAFFIC_BUFFER=1.3
# OSRM_MAX_TABLE_LOCATIONS=1000
# OSRM_TIMEOUT_MS=8000
# OSRM_FAILURE_COOLDOWN_SECS=20
# OSRM_HEALTH_POLL_SECS=60
# OSRM_RECOVERY_CONCURRENCY=3

# -----------------------------------------------------------------------------
# Cloud Matrix Routing Fallback Pool (Optional — used ONLY when self-hosted OSRM
# has no matching region or all matching OSRM endpoints are unreachable / in cooldown)
# Internal load balancer distributes chunks across enabled configured services.
# -----------------------------------------------------------------------------
# ROUTING_FALLBACK_STRATEGY=round_robin
# ROUTING_FALLBACK_ORDER=mapbox_routing,locationiq_routing,freeroute_routing,openrouteservice_routing
# ROUTING_EXTERNAL_TIMEOUT_MS=4500
# ROUTING_EXTERNAL_COOLDOWN_SECS=25
# MAPBOX_ACCESS_TOKEN=
# MAPBOX_API_KEY=
# MAPBOX_BASE_URL=https://api.mapbox.com
# LOCATIONIQ_API_KEY=
# LOCATIONIQ_ACCESS_TOKEN=
# LOCATIONIQ_BASE_URL=https://us1.locationiq.com
# FREEROUTE_API_KEY=
# FREEROUTE_BASE_URL=https://api.maps.freeroute.org
# OPENROUTESERVICE_API_KEY=
# ORS_API_KEY=
# OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org

# -----------------------------------------------------------------------------
# Outbound Networking & Operator-Supplied Proxy Pool (Direct HTTPS by default)
# Zero public free-proxy scraping; supply your own `OUTBOUND_PROXY_URLS` if desired.
# -----------------------------------------------------------------------------
FREE_PROXY_POOL_ENABLED=false
PROXY_POOL_STRICT=false
# OUTBOUND_PROXY_URLS=http://proxy1.example.com:8888,http://proxy2.example.com:8888
# OUTBOUND_NO_PROXY=
# PROXY_POOL_ALLOW_DIRECT_FALLBACK=false

# -----------------------------------------------------------------------------
# OpenStreetMap, USGS 3DEP LiDAR & Public Layer Overrides
# -----------------------------------------------------------------------------
# HOUSE3D_LIDAR=on
# HOUSE3D_LIDAR_CACHE_MB=2048
# OVERPASS_API_URLS=
# OSM_MIRROR_BASE_URL=
# TRANSMISSION_LINES_URL=
# AVIATION_FACILITIES_URL=

# -----------------------------------------------------------------------------
# Hybrid PDF Extraction & OCR (`auto` | `local_only` | `vision_only` | `disabled`)
# -----------------------------------------------------------------------------
OCR_MODE=auto
# TESSERACT_BIN=tesseract
# PDFTOPPM_BIN=pdftoppm
# OPEN_ESTATE_OCR_TIMEOUT_MS=20000

# -----------------------------------------------------------------------------
# Batch Scanner, Background Area Sync & HTTP Rate-Limit Guardrails
# -----------------------------------------------------------------------------
# SCAN_CONCURRENCY=32
# AUTO_SYNC_ENABLED=false
# SYNC_INTERVAL_MIN=0
# SYNC_MAX_ZIPS_PER_TICK=10
# TRUST_PROXY_HEADERS=false
# OPEN_ESTATE_TRUST_PROXY=false
# OPEN_ESTATE_TRUST_CF_HEADERS=false
# OPEN_ESTATE_REQUIRE_INTERNAL_AUTH=false
# OPEN_ESTATE_API_KEY=
# OPEN_ESTATE_INTERNAL_API_KEY=
# OPEN_ESTATE_SESSION_SECRET=
# SESSION_COOKIE_SECURE=false
# ALLOWED_ORIGINS=
# ALLOWED_EXTENSION_IDS=
# ADMIN_API_TOKEN=
# OPEN_ESTATE_BATCH_TOKEN=
# OPEN_ESTATE_BATCH_REQUIRE_TOKEN=false
# CRON_SECRET=

# -----------------------------------------------------------------------------
# Outbound SMTP Email Alerts (`lettre` rustls STARTTLS / TLS + RFC 8058 Unsubscribe)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=tls
# SMTP_USER=alerts@example.com
# SMTP_PASS=
# SMTP_FROM="Open Estate Alerts <alerts@example.com>"
# SMTP_FROM_NAME="Open Estate"
# SMTP_REPLY_TO=

# -----------------------------------------------------------------------------
# Optional Bring-Your-Own-Key (BYOK) Official API Connectors
# -----------------------------------------------------------------------------
# ARCGIS_API_KEY=
# ARCGIS_GEOCODER_URL=https://geocode.arcgis.com/arcgis/rest/services/World/GeocodeServer/findAddressCandidates
# GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_EMBED_KEY=
# MAPILLARY_ACCESS_TOKEN=
# MAPILLARY_API_BASE=https://graph.mapillary.com
# RENTCAST_API_KEY=
# RENTCAST_BASE_URL=https://api.rentcast.io
# RESO_API_URL=
# RESO_BEARER_TOKEN=
# SIMPLYRETS_AUTH=
# ATTOM_API_KEY=
# ATTOM_BASE_URL=https://api.gateway.attomdata.com
# SHOVELS_API_KEY=
# SHOVELS_API_BASE_URL=https://api.shovels.ai/v2
# ZONEOMICS_API_KEY=
# ZONEOMICS_API_BASE_URL=https://api.zoneomics.com/v2/zoneDetail
# COURTLISTENER_API_TOKEN=
# COURTLISTENER_API_URL=https://www.courtlistener.com/api/rest/v4/search/
# GREATSCHOOLS_API_KEY=
# SCHOOLDIGGER_APP_ID=
# SCHOOLDIGGER_APP_KEY=
# PUBLIC_LISTING_FEED_URL=
# SOCRATA_APP_TOKEN=
# CRIME_MUNICIPAL_ENDPOINTS_JSON=
# EDFACTS_FILE_URL=
# DATA_GOV_API_KEY=DEMO_KEY
# CDE_API_KEY=
# AIRNOW_API_KEY=
# OPENEI_API_KEY=
# EIA_API_KEY=DEMO_KEY
# FCC_BDC_USERNAME=
# FCC_BDC_API_TOKEN=
# FCC_BDC_DISABLED=0
# FCC_BDC_API_URL=
# FCC_BDC_MOBILE_API_URL=
# SONIC_AVAILABILITY_DISABLED=0
# INSPECTION_API_URL=
# INSPECTION_API_KEY=
# IP_GEOLOCATION_ENABLED=true
